# ==========================================
# VERDIX AI - Variables de Entorno
# ==========================================
# Copia este archivo a .env y rellena tus valores reales.
# NUNCA subas este archivo a GitHub ni compartas tus claves.

# --- LLM (al menos uno es obligatorio) ---
GROQ_API_KEY=gsk_tu_clave_de_groq_aqui
# OPENAI_API_KEY=sk-tu_clave_de_openai_aqui
# OLLAMA_API_KEY=tu_clave_de_ollama_si_aplica

# --- GitHub (requiere Personal Access Token con scopes: repo, user) ---
GITHUB_TOKEN=ghp_tu_token_de_github_aqui

# --- Vercel ---
VERCEL_TOKEN=tu_token_de_vercel_aqui
# VERCEL_TEAM_ID=tu_id_de_equipo_opcional

# --- Configuración opcional ---
VERDIX_PROVEEDOR=groq
VERDIX_MODELOS=openai/gpt-oss-20b
VERDIX_MAX_INTENTOS=5
VERDIX_CACHE_TTL_HORAS=24
